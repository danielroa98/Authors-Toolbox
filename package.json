    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielroa98/Authors-Toolbox.git"
  },
