{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "DOM",
      "ES2021"
    ],
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/**/*.js"
  ]
}